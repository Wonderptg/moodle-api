        <FIELD NAME="mastery_checkpoints_json" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="mirror_ref" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="source_ref" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rev" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
